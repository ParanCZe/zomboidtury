diff --git a/src/platform/sdl/mobile_input.cpp b/src/platform/sdl/mobile_input.cpp
new file mode 100644
index 0000000..5aaccac
--- /dev/null
+++ b/src/platform/sdl/mobile_input.cpp
@@ -0,0 +1,47 @@
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+#include "mobile_motion.h"
+#include "sdl_events.h"
+#include <ui/keycodes.h>
+#include <win32/win_local.h>
+#include <emscripten/emscripten.h>
+#include <algorithm>
+#include <array>
+
+void Sys_QueEvent(unsigned int, sysEventType_t, int, int, int, void *);
+int CL_MouseEvent(int x, int y, int dx, int dy);
+static bool enabled = false;
+static KBMobileMotion motion;
+static int pointerX = 0, pointerY = 0;
+static std::array<bool, 256> held{};
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE void KBMobile_Reset() {
+    for (int k=0; k<256; ++k) if (held[k]) {
+        Sys_QueEvent(0, SE_KEY, k, 0, 0, nullptr); held[k] = false;
+    }
+    motion.clear();
+}
+EMSCRIPTEN_KEEPALIVE void KBMobile_Enable(int value) {
+    KBMobile_Reset(); enabled = value != 0;
+}
+EMSCRIPTEN_KEEPALIVE void KBMobile_Key(int sdlKey, int down) {
+    if (!enabled) return;
+    int k = sdlKey == -1 ? K_MOUSE1 : sdlKey == -2 ? K_MOUSE2 : Sys_SDLKeyToKeyNum(sdlKey);
+    if (k<=0 || k>=256 || held[k] == (down != 0)) return;
+    held[k] = down != 0;
+    Sys_QueEvent(0, SE_KEY, k, down != 0, 0, nullptr);
+}
+EMSCRIPTEN_KEEPALIVE void KBMobile_Look(double dx, double dy) {
+    if (enabled) motion.add(dx,dy);
+}
+EMSCRIPTEN_KEEPALIVE void KBMobile_Pointer(int x, int y) {
+    pointerX = std::clamp(x,0,8192); pointerY = std::clamp(y,0,8192);
+}
+}
+bool KBMobile_Frame() {
+    if (!enabled) return false;
+    int dx,dy; motion.consume(dx,dy);
+    CL_MouseEvent(pointerX,pointerY,dx,dy);
+    return true;
+}
+#endif
diff --git a/src/platform/sdl/mobile_motion.cpp b/src/platform/sdl/mobile_motion.cpp
new file mode 100644
index 0000000..f6cf798
--- /dev/null
+++ b/src/platform/sdl/mobile_motion.cpp
@@ -0,0 +1,13 @@
+#include "mobile_motion.h"
+#include <cmath>
+#include <algorithm>
+
+void KBMobileMotion::add(double dx, double dy) {
+    if (std::isfinite(dx)) x = std::clamp(x + dx, -4096.0, 4096.0);
+    if (std::isfinite(dy)) y = std::clamp(y + dy, -4096.0, 4096.0);
+}
+void KBMobileMotion::consume(int &dx, int &dy) {
+    dx = static_cast<int>(x); dy = static_cast<int>(y);
+    x -= dx; y -= dy;
+}
+void KBMobileMotion::clear() { x = y = 0; }
