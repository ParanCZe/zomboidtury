diff --git a/src/database/db_raw.cpp b/src/database/db_raw.cpp
new file mode 100644
index 0000000..fee1615
--- /dev/null
+++ b/src/database/db_raw.cpp
@@ -0,0 +1,19 @@
+#include <zlib/zlib.h>
+#include <algorithm>
+#include <cstring>
+
+// IWffr100 stores the XFile header and payload verbatim after magic/version.
+int DB_RawInflate(z_stream_s *stream)
+{
+    const unsigned count = std::min(stream->avail_in, stream->avail_out);
+    if (count) {
+        std::memcpy(stream->next_out, stream->next_in, count);
+        stream->next_in += count;
+        stream->next_out += count;
+        stream->avail_in -= count;
+        stream->avail_out -= count;
+        stream->total_in += count;
+        stream->total_out += count;
+    }
+    return Z_OK;
+}
